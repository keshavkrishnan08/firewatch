# Copy to .env and fill in.  NEVER commit .env (it is gitignored).
#
# ── NASA FIRMS ────────────────────────────────────────────────────────────────
# Free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it, the FIRMS connector is skipped and the picture degrades gracefully
# (the forecast simply widens its uncertainty). Everything else runs keyless.
FIRMS_MAP_KEY=

# ── AWS Open Data (GOES ABI, NOAA HRRR) ───────────────────────────────────────
# NO KEY REQUIRED. These are anonymous public S3 buckets and work out of the box.
# (goes2go / Herbie handle anonymous access automatically.)

# ── Optional overrides ────────────────────────────────────────────────────────
# Root directory for cached event snapshots (default: ./data)
FIREWATCH_DATA_DIR=
# Camera network access is subject to each network's terms of use.
